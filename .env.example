# ProgramAudit example environment. Copy to .env and replace placeholders.
# Never commit real credentials.

NODE_ENV=development
# Port the API server binds to. Choose a port that is not used by any other app.
PORT=4100
# Bind address. Keep 127.0.0.1 behind a reverse proxy; never expose the DB port.
HOST=127.0.0.1

# PostgreSQL connection for ProgramAudit ONLY (separate database + role).
DATABASE_URL=postgres://programaudit:programaudit_local@127.0.0.1:54329/programaudit_dev
# Used by the automated test suite. Tests truncate this database.
TEST_DATABASE_URL=postgres://programaudit:programaudit_local@127.0.0.1:54329/programaudit_test

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=replace-with-a-long-random-string
# Set to true when served over HTTPS (required for any deployment).
COOKIE_SECURE=false
# Public origin of the web UI, used for Origin checks on state-changing requests.
APP_ORIGIN=http://localhost:5173

# Local embedded PostgreSQL (development only)
LOCAL_PG_PORT=54329
LOCAL_PG_USER=programaudit
LOCAL_PG_PASSWORD=programaudit_local

# Seed script: initial administrator (development only)
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=replace-me-locally
