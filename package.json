{
  "name": "programaudit",
  "private": true,
  "version": "0.1.0",
  "description": "Curriculum audit and program review workspace",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:start": "npm run db:start -w server --",
    "db:migrate": "npm run db:migrate -w server --",
    "db:rollback": "npm run db:rollback -w server --",
    "db:seed": "npm run db:seed -w server --",
    "dev:server": "npm run dev -w server --",
    "dev:client": "npm run dev -w client --",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server --",
    "test": "npm run test -w server --",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "bench": "npm run bench -w server --",
    "backup": "npm run backup -w server --",
    "restore": "npm run restore -w server --",
    "e2e": "node e2e/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
