{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src",
    "migrations",
    "scripts",
    "test"
  ],
  "exclude": [
    "scripts/bench.ts",
    "dist"
  ]
}
