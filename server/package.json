{
  "name": "@programaudit/server",
  "version": "0.1.0",
  "description": "ProgramAudit API server",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx --env-file-if-exists=../.env scripts/local-db.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts latest",
    "db:rollback": "tsx --env-file-if-exists=../.env scripts/migrate.ts rollback",
    "db:seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "test": "vitest run",
    "bench": "tsx --env-file-if-exists=../.env scripts/bench.ts",
    "backup": "tsx --env-file-if-exists=../.env scripts/backup.ts backup",
    "restore": "tsx --env-file-if-exists=../.env scripts/backup.ts restore",
    "migrate:prod": "node dist/scripts/migrate.js latest",
    "backup:prod": "node dist/scripts/backup.js backup",
    "restore:prod": "node dist/scripts/backup.js restore"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "docx": "^9.15.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "htmlparser2": "^12.0.0",
    "knex": "^3.3.0",
    "pdfmake": "^0.3.14",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "jszip": "^3.10.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
