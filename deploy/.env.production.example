# ProgramAudit production settings — placeholders only. Copy to
# deploy/.env.production on the server (chmod 600). Never commit real values.

PROGRAMAUDIT_VERSION=0.1.0
# Unused host port chosen after the read-only port inventory (docs/DEPLOYMENT_PLAN.md §2).
PROGRAMAUDIT_HOST_PORT=REPLACE_WITH_UNUSED_PORT
# Public HTTPS origin agreed with the owner (separate hostname; NOT the existing app's URL).
PROGRAMAUDIT_ORIGIN=https://REPLACE-WITH-PROGRAMAUDIT-HOSTNAME
# Long random values, e.g. `openssl rand -hex 32`
PROGRAMAUDIT_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
PROGRAMAUDIT_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
